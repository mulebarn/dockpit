Screen {
    background: #282828;
    color: #ebdbb2;
    layout: vertical;
}

#app-header {
    height: 5;
    background: #3c3836;
    border-bottom: heavy #504945;
    padding: 0 1;
}

#app-title {
    color: #fe8019;
    text-style: bold;
    height: 1;
    content-align: left middle;
    padding: 0 1;
}

#app-subtitle {
    color: #fabd2f;
    height: 1;
    text-style: bold;
    padding: 0 1;
}

#header-controls {
    height: 2;
    width: 1fr;
    align: left middle;
}

#container-filter {
    width: 28;
    margin: 0 2;
    background: #1d2021;
    border: tall #504945;
    color: #ebdbb2;
}

#log-filter {
    width: 24;
    margin: 0 1;
    background: #1d2021;
    border: tall #504945;
    color: #ebdbb2;
}

#container-stats {
    color: #b8bb26;
    text-style: bold;
    content-align: right middle;
    width: 1fr;
    padding: 0 3 0 1;
}

#attention-banner {
    display: none;
    color: #fb4934;
    text-style: bold;
    width: auto;
    padding: 0 1;
}

#main {
    width: 1fr;
    height: 3fr;
    layout: horizontal;
}

#containers {
    width: 60%;
    height: 1fr;
    margin: 0 0 0 1;
    border: heavy #504945;
    border-title-color: #fe8019;
    background: #1d2021;
    color: #ebdbb2;
}

#containers > .datatable--cursor {
    background: #fabd2f;
    color: #1d2021;
    text-style: bold reverse;
}

#containers > .datatable--header {
    background: #3c3836;
    color: #fabd2f;
    text-style: bold;
}

#containers > .datatable--hover {
    background: #3c3836;
}

#details {
    width: 40%;
    height: 1fr;
    margin: 0 1 0 1;
    padding: 0 1;
    border: round #8ec07c;
    border-title-color: #8ec07c;
    background: #1d2021;
    color: #ebdbb2;
}

.panel-title {
    color: #fe8019;
    text-style: bold;
    background: #282828;
    padding: 0 1;
    margin-bottom: 1;
}

.detail-row {
    height: auto;
    margin-bottom: 1;
}

#output {
    height: 2fr;
    margin: 0 1 1 1;
    padding: 0 1;
    border: round #504945;
    border-title-color: #fabd2f;
    background: #1d2021;
    color: #ebdbb2;
}

#containers:focus {
    border: heavy #fabd2f;
}

ConfirmScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#confirm-dialog {
    width: 64;
    height: auto;
    padding: 1 2;
    border: heavy #fabd2f;
    background: #1d2021;
}

.confirm-title {
    color: #fabd2f;
    text-style: bold;
    margin-bottom: 1;
}

#confirm-message {
    color: #ebdbb2;
    margin-bottom: 1;
}

#confirm-actions {
    align: right middle;
    height: auto;
}

#confirm-actions Button {
    margin-left: 1;
}

Footer {
    background: #3c3836;
}

Footer > .footer--key {
    color: #fbf1c7;
    text-style: bold;
}

Footer > .footer--description {
    color: #ebdbb2;
}